{
  "expo": {
    "name": "ColorHarmonizer",
    "slug": "ColorHarmonizer",
    "version": "3.0.1",
    "orientation": "portrait",
    "icon": "./assets/AppIcon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clarkbarrett101.ColorHarmonizer",
      "buildNumber": "2"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/AppIcon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.clarkbarrett101.ColorHarmonizer"
    },
    "web": {
      "favicon": "./assets/AppIcon.png"
    },
    "extra": {
      "eas": {
        "projectId": "6f05c862-6a0c-4d89-809d-82f955b7e394"
      }
    },
    "plugins": [
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "ColorHarmonizer needs access to your camera so you can measure undertone colors and view walls with different paint colors."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/Outfit-VariableFont_wght.ttf"
          ]
        }
      ],
      ["react-native-audio-api",
      {
        "iosBackgroundMode": true,
        "iosMicrophonePermission": "This app requires access to the microphone to record audio.",
        "androidPermissions" : [
          "android.permission.MODIFY_AUDIO_SETTINGS",
          "android.permission.FOREGROUND_SERVICE",
          "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
        ],
        "androidForegroundService": true,
        "androidFSTypes": [
          "mediaPlayback"
        ]
      }
    ]]
  }
}
